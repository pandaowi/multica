# Salin menjadi .env, isi sesuai deployment. Jangan menaruh nilai token di sini.
DEPLOYMENT_ID=coder-pilot
CODER_SSH_HOST=operator@10.0.0.44
CODER_BIND_IP=10.0.0.44
MULTICA_SSH_HOST=operator@multica-vm.example.internal
CF_GATEWAY_SSH_HOST=operator@10.0.0.101
# Alamat gateway yang dapat dicapai DARI VM Coder, bisa berupa alamat ZeroTier.
CF_BROKER_SSH_TARGET=cf-coder-pilot@10.0.0.101
CF_BROKER_ALLOWED_SOURCE=10.0.0.44
CODER_DOMAIN=coder-new.example.com
PREVIEW_DOMAIN_SUFFIX=preview-new.example.com
CF_ZONE_NAME=example.com
CF_ACCOUNT_ID=
CF_TUNNEL_ID=
CF_ORIGIN_HOSTNAME=apps-new.example.com
# Lokasi file pada 7.101. Nilai token tidak pernah disalin ke VM Coder.
CF_DNS_TOKEN_FILE=/etc/coder-cloudflare/coder-pilot-dns.token
CF_TUNNEL_TOKEN_FILE=/etc/coder-cloudflare/coder-pilot-tunnel.token
CODER_API_PORT=7081
PREVIEW_PROXY_PORT=7084
# Jaringan admin/gateway yang boleh mencapai dua port layanan Coder.
CODER_ALLOWED_CIDRS=10.0.0.0/24,10.0.0.101/32
CODER_USER=coder
INSTALL_ROOT=/opt/coder-pilot
CODER_AUTHORIZED_KEY_FILE=~/.ssh/id_ed25519.pub
CF_GATEWAY_HOST_KEY_FILE=~/.ssh/known_hosts
# Isi hasil ssh-keygen -lf setelah host key gateway diverifikasi operator.
# known_hosts tidak diambil otomatis dari jaringan tanpa verifikasi.
CODER_IMAGE=ghcr.io/coder/coder:v2.38.6
POSTGRES_IMAGE=postgres:17-alpine
TRAEFIK_IMAGE=traefik:v3.7.18
# Anggaran seluruh akun coder: container platform + workspace + daemon Docker.
POOL_CPU=6
POOL_MEMORY_MIB=6144
POOL_MEMORY_HIGH_MIB=5376
POOL_SWAP_MIB=0
PLATFORM_RESERVE_CPU=3
PLATFORM_RESERVE_MEMORY_MIB=3072
WORKSPACE_CPU=2
WORKSPACE_MEMORY_MIB=3072
WORKSPACE_PIDS=512
MAX_WORKSPACES=1
MIN_FREE_DISK_GIB=20
BUILD_CPU=1
BUILD_MEMORY_MIB=768
# Fresh-host installer tidak akan dijalankan pada alamat layanan lama ini.
PROTECTED_HOST_IPS=10.0.0.10,10.0.0.101

# VM Multica baru; semua alamat contoh wajib disesuaikan.
MULTICA_BIND_IP=10.0.0.45
MULTICA_DOMAIN=multica-new.example.com
MULTICA_HTTP_PORT=8088
MULTICA_INSTALL_ROOT=/opt/multica-coder-pilot
MULTICA_ALLOWED_CIDRS=10.0.0.0/24,10.0.0.101/32
MULTICA_POOL_CPU=6
MULTICA_POOL_MEMORY_MIB=6144
MULTICA_SOURCE_REPO=https://github.com/pandaowi/multica.git
MULTICA_SOURCE_REV=67046a46b51f9b3a28ad0e666a6e574fe692811b
MULTICA_PG_IMAGE=pgvector/pgvector:pg17
MULTICA_EDGE_IMAGE=nginx:1.28-alpine
MULTICA_BUILD_MEMORY_MIB=5120
MULTICA_OPERATOR_EMAIL=admin@example.com
# SMTP auth berada pada file privat di VM Multica, bukan inline di .env.
MULTICA_SMTP_HOST=
MULTICA_SMTP_PORT=587
MULTICA_SMTP_TLS=starttls
MULTICA_SMTP_FROM=
MULTICA_SMTP_USER=
MULTICA_SMTP_PASSWORD_FILE=/etc/multica-coder-pilot/smtp-password
MULTICA_OPERATOR_TOKEN_FILE=/etc/multica-coder-pilot/operator.token
MULTICA_RUNTIME_TOKEN_DIR=/etc/multica-coder-pilot/runtime-tokens
RUNTIME_CODEX_VERSION=0.169.0
# AGY opsional: binary Linux amd64 disediakan operator dan diverifikasi SHA-256.
RUNTIME_AGY_BINARY_FILE=
RUNTIME_AGY_SHA256=
RUNTIME_CPU=2
RUNTIME_MEMORY_MIB=3072
RUNTIME_MAX_CONCURRENT_TASKS=2
CODER_HOST_KEY_FILE=~/.ssh/known_hosts
CODER_PROJECT_BROKER_USER=coder-job
INTERCONNECT_SOURCE_CIDR=10.0.0.45/32
INTERCONNECT_GRANT_HOURS=720
