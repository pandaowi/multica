#!/usr/bin/env python3
"""Runtime tool. No selectable host/workspace: server-side key grant is authority."""
import argparse,base64,json,os,subprocess,sys
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('action',choices=['exec','write','read','list','preview','status','doctor']);p.add_argument('args',nargs=argparse.REMAINDER);a=p.parse_args()
home=Path('/capability');b=json.loads((home/'binding.json').read_text())
request={'action':a.action}
if a.action=='exec':request['argv']=a.args[1:] if a.args[:1]==['--'] else a.args
elif a.action=='write':
 if len(a.args)!=1:p.error('write PATH < content')
 request.update(path=a.args[0],content_b64=base64.b64encode(sys.stdin.buffer.read(786433)).decode())
elif a.action in ['read','list']:
 if len(a.args)!=1:p.error('read/list PATH')
 request['path']=a.args[0]
elif a.action=='doctor':request={'action':'exec','argv':['python3','-c','import os,json;print(json.dumps({"uid":os.getuid(),"cwd":os.getcwd()}))']}
command=['ssh','-T','-i',str(home/'project_key'),'-o','IdentitiesOnly=yes','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','UserKnownHostsFile='+str(home/'known_hosts'),'-o','ConnectTimeout=10',b['broker_target']]
r=subprocess.run(command,input=json.dumps(request)+'\n',capture_output=True,text=True,timeout=330)
try:d=json.loads(r.stdout)
except ValueError:print('Project connection unavailable; contact platform operator.',file=sys.stderr);sys.exit(1)
if 'error' in d:print(d['error'],file=sys.stderr);sys.exit(1)
if a.action in ['read','list','write'] and d.get('exit_code')==0:
 obj=json.loads(d['stdout'])
 if a.action=='read':sys.stdout.buffer.write(base64.b64decode(obj['content_b64']))
 else:print(json.dumps(obj))
else:
 sys.stdout.write(d.get('stdout',''));sys.stderr.write(d.get('stderr',''))
 if d.get('output_truncated'):print('\n[output truncated]',file=sys.stderr)
sys.exit(d.get('exit_code',1))
