#!/usr/bin/env python3
"""Create a committed-app manifest. No host credentials or Docker access needed."""
import json
from pathlib import Path
import re
import subprocess
import sys

if len(sys.argv) != 2 or not re.fullmatch(r'[a-z][a-z0-9]*(?:-[a-z0-9]+)*', sys.argv[1]) or len(sys.argv[1]) > 40:
    raise SystemExit('Usage: coder-publish APP_NAME (lowercase letters, digits, hyphens)')
name = sys.argv[1]
if name in {'admin', 'api', 'dashboard', 'traefik', 'www', 'coder', 'origin'}:
    raise SystemExit('That app name is reserved')
root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
if not (root / 'site/index.html').is_file():
    raise SystemExit('Create site/index.html inside this Git repository first')
target = root / '.coder-app.json'
manifest = {'version': 1, 'name': name, 'kind': 'static', 'directory': 'site'}
if target.exists() and json.loads(target.read_text()) != manifest:
    raise SystemExit('Existing manifest differs; edit it deliberately rather than replacing it')
target.write_text(json.dumps(manifest, indent=2) + '\n')
print('Manifest ready for https://' + name + '.coder.example.com')
print('Review, then commit .coder-app.json and site/ to request automatic deployment.')
print('Domain activation requires the host Cloudflare configuration to be completed.')
