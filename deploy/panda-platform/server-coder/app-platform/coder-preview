#!/usr/bin/env python3
"""Workspace-local preview supervisor. Coding agents operate it; users receive URLs."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.request
import urllib.error

HOME = Path(os.environ.get('CODER_PREVIEW_HOME', str(Path.home())))
ROOT = HOME / '.config/coder-preview'
PROJECTS = HOME / 'projects'
STATE = HOME / '.local/state/coder-preview'
REGISTRY = ROOT / 'apps.json'
SUFFIX = 'coder.example.com'


class LocalHealthNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


HEALTH = urllib.request.build_opener(urllib.request.ProxyHandler({}), LocalHealthNoRedirect())


def http_ready(port, path='/'):
    if not isinstance(path, str) or not re.fullmatch(r'/[A-Za-z0-9/_-]*', path):
        raise ValueError('Invalid local health path')
    try:
        with HEALTH.open('http://127.0.0.1:' + str(port) + path, timeout=.75) as response:
            return response.status < 400
    except urllib.error.HTTPError as error:
        # A login redirect is a healthy HTTP response; never follow it to an
        # arbitrary URL or render a second page on every health check.
        code = error.code
        error.close()
        return 300 <= code < 400
    except (OSError, ValueError):
        return False


def atomic(path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.tmp')
    tmp.write_text(json.dumps(obj, indent=2) + '\n')
    tmp.chmod(0o600)
    tmp.replace(path)


@contextmanager
def locked(name):
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / name).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def read_registry():
    data = json.loads(REGISTRY.read_text()) if REGISTRY.exists() else {}
    if not isinstance(data, dict): raise ValueError('Invalid preview registry')
    return data


def free_port(port):
    try:
        with socket.socket() as sock: sock.bind(('0.0.0.0', port))
        return True
    except OSError: return False


def allocate(apps, owner, preferred=None):
    used = {a['port'] for name, a in apps.items() if name != owner}
    candidates = ([preferred] if preferred is not None else []) + list(range(3000, 4000))
    for port in candidates:
        if type(port) is int and 3000 <= port <= 3999 and port not in used and free_port(port):
            return port
    raise ValueError('No free preview port in 3000..3999')


def validate_slug(slug):
    if len(slug) > 40 or not re.fullmatch(r'preview-[a-z][a-z0-9]*(?:-[a-z0-9]+)*', slug):
        raise ValueError('Invalid preview name')
    return slug


def infer_command(project):
    package = project / 'package.json'
    if package.exists():
        p = json.loads(package.read_text()); scripts = p.get('scripts', {})
        for script in ('dev', 'start'):
            command = scripts.get(script, '')
            if re.search(r'\bnext\s+dev\b', command):
                return ['npm', 'run', script, '--', '--hostname', '0.0.0.0', '--port', '{port}']
            if re.search(r'\bvite\b', command):
                return ['npm', 'run', script, '--', '--host', '0.0.0.0', '--port', '{port}', '--strictPort']
            if 'react-scripts start' in command:
                return ['npm', 'run', script]
    for directory in ('site', 'dist', 'public'):
        if (project / directory / 'index.html').is_file():
            return [sys.executable, '-m', 'http.server', '{port}', '--bind', '0.0.0.0', '--directory', directory]
    raise ValueError('Agent must supply the dev command after --, using {port} or PORT environment variable')


def manifest(project, app):
    atomic(project / '.coder-preview.json', {'version': 1, 'name': app['name'],
                                          'port': app['port'], 'public': True})


def identity(pid):
    try:
        raw = Path('/proc/' + str(pid) + '/stat').read_text()
        rest = raw[raw.rfind(')') + 2:].split()
        if rest[0] == 'Z': return None
        return Path('/proc/sys/kernel/random/boot_id').read_text().strip() + ':' + rest[19]
    except (OSError, IndexError): return None


def process_alive(state):
    return bool(state and identity(state.get('pid')) == state.get('identity') and state.get('identity'))


def stop_process(state):
    if not process_alive(state): return
    pid = state['pid']
    # Only signal the process group created and recorded by this supervisor.
    if os.getpgid(pid) != pid: raise ValueError('Preview process group mismatch')
    os.killpg(pid, signal.SIGTERM)
    for _ in range(20):
        if not process_alive(state): return
        time.sleep(.1)
    if process_alive(state): os.killpg(pid, signal.SIGKILL)


def ensure_supervisor():
    STATE.mkdir(parents=True, exist_ok=True)
    with (ROOT / 'daemon.lock').open('a') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: return
        with (STATE / 'supervisor.log').open('a') as log:
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'serve'],
                stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    # serialize startup callers until the daemon owns its lifetime lock
    for _ in range(30):
        with (ROOT / 'daemon.lock').open('a') as probe:
            try: fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError: return
        time.sleep(.1)
    raise ValueError('Preview supervisor did not start; inspect supervisor.log')


def watchdog(check=False):
    """Inspect the lifetime lock without signalling or restarting any application."""
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / 'daemon.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            running = False
        except BlockingIOError:
            running = True
    if running:
        heartbeat = STATE / 'supervisor.json'
        try:
            data = json.loads(heartbeat.read_text())
            fresh = process_alive(data) and time.time() - data['heartbeat_at'] < 30
            return {'state': 'running' if fresh else 'heartbeat_stale', 'started': False}
        except (OSError, ValueError, KeyError):
            # Old supervisors are deliberately adopted without a live upgrade.
            return {'state': 'running_legacy', 'started': False}
    if not any(a.get('enabled') is True for a in read_registry().values()):
        return {'state': 'idle', 'started': False}
    if check:
        return {'state': 'stopped', 'started': False}
    ensure_supervisor()
    return {'state': 'recovered', 'started': True}


def register(args):
    project = Path.cwd().resolve()
    if project.parent != PROJECTS.resolve(): raise ValueError('Run in a project directly under ~/projects')
    with locked('registry.lock'):
        apps = read_registry()
        existing = next((a for a in apps.values() if a['project'] == str(project)), None)
        previous = project / '.coder-preview.json'
        old = json.loads(previous.read_text()) if previous.exists() else {}
        if args.name:
            slug = args.name if args.name.startswith('preview-') else 'preview-' + args.name
        elif existing: slug = existing['name']
        elif old.get('name'): slug = old['name']
        else:
            part = re.sub('[^a-z0-9]+', '-', project.name.lower()).strip('-')[:21]
            if not part or not part[0].isalpha(): part = 'app-' + part[:17]
            wid = (ROOT / 'workspace-id').read_text().strip() if (ROOT / 'workspace-id').exists() else str(HOME)
            slug = 'preview-' + part + '-' + hashlib.sha256((wid + '\0' + project.name).encode()).hexdigest()[:8]
        validate_slug(slug)
        if existing and existing['name'] != slug: raise ValueError('Rename requires explicit retirement of the old preview')
        if slug in apps and apps[slug]['project'] != str(project): raise ValueError('Preview name belongs to another project')
        command = args.command
        if command[:1] == ['--']: command = command[1:]
        command = command or (existing or {}).get('command') or infer_command(project)
        if not all(isinstance(x, str) and x for x in command): raise ValueError('Invalid dev command')
        health_path = args.health_path if args.health_path is not None else (existing or {}).get('health_path', '/')
        if not isinstance(health_path, str) or not re.fullmatch(r'/[A-Za-z0-9/_-]*', health_path):
            raise ValueError('Invalid local health path')
        state_path = STATE / (slug + '.json')
        state = json.loads(state_path.read_text()) if state_path.exists() else {}
        same = existing and existing['command'] == command and existing.get('enabled') and not args.restart
        port = existing['port'] if same and process_alive(state) else allocate(apps, slug, (existing or old).get('port'))
        revision = existing.get('revision', 0) if same else (existing or {}).get('revision', 0) + 1
        app = {'name': slug, 'project': str(project), 'port': port, 'command': command,
               'enabled': True, 'revision': revision, 'url': 'https://' + slug + '.' + SUFFIX,
               'health_path': health_path}
        apps[slug] = app
        manifest(project, app)
        atomic(REGISTRY, apps)
    ensure_supervisor()
    print(app['url'], flush=True)
    deadline = time.monotonic() + args.wait
    while time.monotonic() < deadline:
        if state_path.exists():
            status = json.loads(state_path.read_text())
            if status.get('revision') == revision and status.get('ready') and process_alive(status):
                print('Local preview ready. Agent must verify public HTTPS before handing off the link.')
                return
        time.sleep(.5)
    raise ValueError('Preview is registered but not ready; agent must inspect ' + str(state_path))


def serve():
    ROOT.mkdir(parents=True, exist_ok=True); STATE.mkdir(parents=True, exist_ok=True)
    with (ROOT / 'daemon.lock').open('a') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: return
        children = {}
        while True:
            try:
                atomic(STATE / 'supervisor.json', {'pid': os.getpid(),
                    'identity': identity(os.getpid()), 'heartbeat_at': time.time(),
                    'protocol_version': 1})
                with locked('registry.lock'): apps = read_registry()
                for slug, app in apps.items():
                    try:
                        validate_slug(slug)
                        project = Path(app['project'])
                        if project.resolve().parent != PROJECTS.resolve(): raise ValueError('Invalid project path')
                        path = STATE / (slug + '.json')
                        state = json.loads(path.read_text()) if path.exists() else {}
                        if not app.get('enabled') or state.get('revision') != app['revision']:
                            stop_process(state)
                            state = {}
                        if not app.get('enabled'):
                            atomic(path, {'enabled': False}); continue
                        if not process_alive(state):
                            if time.time() < state.get('retry_at', 0): continue
                            with locked('registry.lock'):
                                current = read_registry()
                                if current.get(slug) != app: continue
                                app['port'] = allocate(current, slug, app['port'])
                                current[slug] = app; manifest(project, app); atomic(REGISTRY, current)
                            command = [x.replace('{port}', str(app['port'])) for x in app['command']]
                            env = os.environ.copy()
                            env.update(PORT=str(app['port']), HOST='0.0.0.0',
                                __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=slug + '.' + SUFFIX)
                            with (STATE / (slug + '.log')).open('a') as log:
                                child = subprocess.Popen(command, cwd=project, env=env,
                                    stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
                            children[slug] = child
                            state = {'pid': child.pid, 'identity': identity(child.pid),
                                     'revision': app['revision'], 'port': app['port'], 'ready': False,
                                     'started_at': time.time(), 'retry_at': time.time() + 10}
                        ready = False
                        if process_alive(state):
                            if not state.get('ready') or state.get('health_checked_path') != app.get('health_path', '/') or time.time() - state.get('http_checked_at', 0) >= 30:
                                ready = http_ready(state['port'], app.get('health_path', '/'))
                                state['http_checked_at'] = time.time()
                                state['health_checked_path'] = app.get('health_path', '/')
                            else:
                                # Cheap listener check between bounded HTTP probes.
                                try:
                                    with socket.create_connection(('127.0.0.1', state['port']), timeout=.2):
                                        ready = True
                                except OSError:
                                    pass
                        state['ready'] = ready
                        atomic(path, state)
                    except Exception as exc:
                        print(slug, 'preview error:', str(exc), flush=True)
                for log in STATE.glob('*.log'):
                    if log.stat().st_size > 5 * 1024 * 1024:
                        log.write_text('Log truncated at 5 MiB by preview supervisor\n')
                for slug, child in list(children.items()):
                    if child.poll() is not None: children.pop(slug)
            except Exception as exc:
                print('Supervisor error:', str(exc), flush=True)
            time.sleep(2)


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest='action', required=True)
    start = sub.add_parser('start')
    start.add_argument('--name'); start.add_argument('--restart', action='store_true')
    start.add_argument('--health-path')
    start.add_argument('--wait', type=float, default=30)
    start.add_argument('command', nargs=argparse.REMAINDER)
    sub.add_parser('serve'); sub.add_parser('status')
    watch = sub.add_parser('watchdog')
    watch.add_argument('--check', action='store_true')
    stop = sub.add_parser('stop'); stop.add_argument('name')
    args = parser.parse_args()
    os.umask(0o077)
    if args.action == 'start': register(args)
    elif args.action == 'serve': serve()
    elif args.action == 'watchdog': print(json.dumps(watchdog(args.check)))
    elif args.action == 'status':
        for slug, app in read_registry().items():
            path = STATE / (slug + '.json')
            state = json.loads(path.read_text()) if path.exists() else {}
            print(json.dumps({'name': slug, 'url': app['url'], 'port': app['port'],
                'enabled': app['enabled'], 'ready': bool(state.get('ready') and process_alive(state))}))
    elif args.action == 'stop':
        slug = validate_slug(args.name if args.name.startswith('preview-') else 'preview-' + args.name)
        with locked('registry.lock'):
            apps = read_registry(); apps[slug]['enabled'] = False; atomic(REGISTRY, apps)
            (Path(apps[slug]['project']) / '.coder-preview.json').unlink(missing_ok=True)
        ensure_supervisor()


if __name__ == '__main__':
    try: main()
    except (ValueError, OSError, KeyError) as exc:
        print(str(exc), file=sys.stderr); sys.exit(1)
